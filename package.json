{
  "name": "kestrel",
  "version": "0.1.0",
  "description": "Local-first terminal companion for finding, preparing, and recording real open-source engineering challenges.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "kestrel": "dist/cli/main.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run boundaries && npm run lint && npm run format:check && npm run typecheck && npm test",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check:runtime": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "@octokit/auth-oauth-device": "^7.1.4",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.4.0",
    "ink": "^5.0.1",
    "octokit": "^4.0.2",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.10",
    "eslint": "^9.12.0",
    "globals": "^17.11.0",
    "ink-testing-library": "^3.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "prepack": "npm run build"
}
